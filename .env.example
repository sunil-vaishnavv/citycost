# =============================================================================
# CityCost Global — production environment template
# Copy to `.env` and fill values. Never commit real secrets.
# =============================================================================

# --- Runtime (required on host) ---
NODE_ENV=production
PORT=3001

# Public site URL used in sitemaps / canonicals (keep in sync with src/utils/seo.ts SITE_URL)
APP_URL=https://citycost.online

# Comma-separated browser origins. Prefer explicit hosts in production.
# Example: https://citycost.online,https://www.citycost.online
# Use * only for open public APIs (credentials disabled when *).
ALLOWED_ORIGINS=https://citycost.online

# --- AI Providers (synced with Admin → Settings → AI Providers) ---
# Writer / Reviewer / SEO use the AI Router with automatic failover.
# Paste real keys; placeholders are ignored. Saving in admin writes back here.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# --- External COL data (optional) ---
NUMBEO_API_KEY=

# --- PostgreSQL (Neon) — optional; app runs without DB if unset ---
# Use the Neon connection string (SSL required).
# Example:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/citycost?sslmode=require
# Apply COL schema once: psql "$DATABASE_URL" -f db/schema.pg.sql
DATABASE_URL=
# Optional pool size override
# PG_POOL_MAX=10

# --- Admin / ops ---
# Required to call POST /api/content/regenerate (header: x-admin-token)
CONTENT_ADMIN_TOKEN=
ADMIN_API_TOKEN=

# --- Editorial Engine (P0+) ---
# Bootstrap admin password on first boot when the database is available (≥12 characters).
# Used only to create editorial_admin.password_hash — not stored in plaintext.
# Login UI: http://localhost:3000/admin  (API: /api/editorial)
EDITORIAL_ADMIN_PASSWORD=

# NOTE: PUBLIC_SITE_URL and EDITORIAL_SITE_BASE_URL are not used by this codebase.
# Canonical/public URL comes from APP_URL (docs) and src/utils/seo.ts SITE_URL.

# --- SEO index scale (optional) ---
SEO_MAX_CITIES=500
SEO_MAX_COMPARISONS=10000
SEO_MIN_ELIGIBILITY=52
SEO_MIN_CONTENT=55
SEO_MIN_COMPARISON_SCORE=42
SEO_MIN_POPULATION=80000
SEO_COMPS_PER_CITY=12
SEO_COMP_CITIES_PER_COUNTRY=40
SEO_CROSS_TOP_CITIES=80
SEO_COUNTRY_CITY_LIST=40

# --- Traffic Growth / Content engines (optional) ---
INTENT_MAX_LANDINGS_PER_KIND=
CONTENT_AI_REFINE=0
